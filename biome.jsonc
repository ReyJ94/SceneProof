{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "src/**",
      "tests/**/*.ts",
      "tests/**/*.tsx",
      "examples/**/*.ts",
      "examples/**/*.tsx",
      "*.json",
      "*.jsonc"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": "off"
      }
    }
  }
}
