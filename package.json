{
  "name": "sceneproof",
  "version": "0.8.1",
  "description": "Source-grounded visual evidence harness for coding agents—inspect, render, and compare real React and Three.js surfaces.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "sceneproof": "./src/cli.ts",
    "uiscene": "./src/cli.ts"
  },
  "exports": {
    "./session": "./src/session.ts",
    "./react": "./src/react-fixture.ts",
    "./three": "./src/three-fixture.ts"
  },
  "files": [
    "src",
    "docs",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReyJ94/SceneProof.git"
  },
  "homepage": "https://github.com/ReyJ94/SceneProof#readme",
  "bugs": {
    "url": "https://github.com/ReyJ94/SceneProof/issues"
  },
  "keywords": [
    "coding-agents",
    "visual-testing",
    "ui",
    "threejs",
    "webgl",
    "webgpu",
    "react",
    "source-rendering",
    "agent-tools",
    "visual-evidence",
    "testing-harness"
  ],
  "scripts": {
    "build": "bun --no-env-file build --compile --allow-unresolved '' --outfile dist/sceneproof src/cli.ts",
    "check": "bun --no-env-file run lint && bun --no-env-file run typecheck && bun --no-env-file run test && bun --no-env-file run build && bun --no-env-file run test:compiled",
    "cli": "bun --no-env-file src/cli.ts",
    "format": "ultracite fix .",
    "format:check": "ultracite check .",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "prepack": "bun --no-env-file run check",
    "test": "bun --no-env-file test --timeout 0 tests/agent-surface.test.ts tests/browser-gpu.test.ts tests/browser-runtime.test.ts tests/cli.test.ts tests/frame-schedule.test.ts tests/installation-diagnostics.test.ts tests/react-renderer.test.ts tests/source-bundle.test.ts tests/session-store.test.ts tests/session.test.ts tests/session-gpu.test.ts tests/session-cli.test.ts",
    "test:cli": "bun --no-env-file test --timeout 0 tests/cli.test.ts",
    "test:compiled": "bun --no-env-file tests/compiled-cli-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "commander": "15.0.0",
    "esbuild": "0.28.1",
    "playwright-core": "1.61.1",
    "postcss": "8.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.4.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "ultracite": "7.9.4"
  }
}
